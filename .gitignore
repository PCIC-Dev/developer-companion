supabase/.temp/
supabase/.branches/
supabase/.env

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# Test / coverage output
coverage/

# Editor / OS
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
